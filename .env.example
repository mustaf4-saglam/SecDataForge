# SecDataForge ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve kendi ortamanıza göre düzenleyin.
# Gerçek API anahtarlarını asla depoya eklemeyin.

# Veri tabanı ve veri dizinleri
DB_PATH=data/secdataforge.db
DATA_DIR=data

# Varsayılan toplama sınırı (kaynak başına)
DEFAULT_RECORD_LIMIT=100
REQUEST_TIMEOUT=30.0
MAX_RETRIES=3
BACKOFF_FACTOR=2.0

# GitHub Global Security Advisories (istemci kimliği/token opsiyoneldir; sınırlı oran anahtarı vardır)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_BASE_URL=https://api.github.com

# OSV Vulnerability API
OSV_BASE_URL=https://api.osv.dev/v1

# LLM entegrasyonu (opsiyonel, varsayılan olarak kapalı)
LLM_ENABLED=false
LLM_PROVIDER=ollama          # ollama | openai_compatible | gemini | claude | huggingface
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_API_KEY=                 # openai_compatible için genel anahtar
LLM_TEMPERATURE=0.0
# LLM istek zaman aşımı (saniye); yavaş yerel modeller için artırın
LLM_TIMEOUT=120.0

# Sağlayıcı bazlı API anahtarları (LLM_API_KEY kullanılmıyorsa öncelikli)
GEMINI_API_KEY=              # Google AI Studio: https://aistudio.google.com/
CLAUDE_API_KEY=              # Anthropic: https://console.anthropic.com/
# veya ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=         # Hugging Face: https://huggingface.co/settings/tokens
# veya HF_API_KEY=

# EVREN LLM API (Türkiye, SAYZEK ekosistemi; OpenAI uyumlu)
# DİKKAT: Bu dosyayı .env olarak kopyalayın; gerçek anahtarı ASLA koda/depoya yazmayın.
EVREN_API_KEY=
EVREN_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
EVREN_MODEL=                 # boş bırakılırsa /models listesinden ilk model seçilir
EVREN_TERMS_URL=https://evren-llmapi.ssyz.org.tr   # resmî şart adresini kendiniz doğrulayın
